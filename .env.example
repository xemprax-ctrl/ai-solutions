# Copy this file to .env and add your own key for --use-api mode.
OPENROUTER_API_KEY=
# Optional: change the model used by OpenRouter.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Keep generated answers concise while allowing a useful summary and steps.
OPENROUTER_MAX_TOKENS=300
# Optional metadata sent to OpenRouter.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Grounded AI Solutions Assistant